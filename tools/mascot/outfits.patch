+    ], {})
+    art["Shades"] = ([
+        shape("Shine", [rect(26, 7, 3, -66, -95), rect(26, 7, 3, 46, -95)], [fill("99FFFFFF")]),
+        lined("LensL", [pts([("s", -104, -107, 10), ("s", -14, -107, 10), ("s", -22, -57, 26), ("s", -92, -57, 26)])], INK),
