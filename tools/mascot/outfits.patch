+# Worn on any pose, chosen by the view model number "outfit" (append only).
+OUTFITS = ["None", "HardHat", "Toque", "Headphones", "Party", "Crown", "Shades", "Propeller", "GradCap"]
 
 
+def build_outfits():
+    """The outfit, over the head. Poses that bring their own hat hide it."""
+    art = {n: (kids, kw) for n, kids, kw in hat_art()}
+    art["Toque"] = ([
+        lined("Pom", [ellipse(44, 44, 0, -250)], CREAM),
+        lined("Cuff", [rect(176, 36, 17, 0, -170)], RED),
+        shape("Band", [pts([("s", -62, -206), ("m", 0, -222, 0, 30), ("s", 62, -206)], False)], [stroke(CREAM, 10)]),
