+        shape("Bridge", [pts([("s", -20, -99), ("s", 20, -99)], False)], [stroke(OUT, 9)]),
+    ], {})
+    return rnode("OutfitWrap", [solo_set("Outfit", [(n, art[n][0], art[n][1]) for n in OUTFITS], "Outfit")])
+
+
+def build_outfit_anims():
+    out = []
+    for name in OUTFITS:
+        a = Anim("Outfit " + name, 30, "oneShot")
+        a.k("Outfit", "activeComponentId", [(0, RIG["Outfit" + name])], "hold")
+        out.append((name, a))
+    return out
